<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.StoreMeNative.Card.Enterprise"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/bg_surface">

    <LinearLayout 
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_meta_chip"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="File Properties &amp; Metadata"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FILE NAME"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/text_secondary"/>
        <TextView
            android:id="@+id/detailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="filename.ext"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CATEGORY"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/text_secondary"/>
        <TextView
            android:id="@+id/detailType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Document"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIZE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/text_secondary"/>
        <TextView
            android:id="@+id/detailSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 B"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"/>
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STORAGE PATH"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/text_secondary"/>
        <TextView
            android:id="@+id/detailPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="/path/to/file"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseDetails"
            style="@style/Widget.StoreMeNative.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Close"
            android:textAllCaps="false"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
