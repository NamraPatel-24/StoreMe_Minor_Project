<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.StoreMeNative.Card.Enterprise"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="@dimen/card_radius"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/bg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground">

        <!-- 44dp Rounded Icon Container with Category Tinting -->
        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_file_icon_container">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_document"
                app:tint="@color/primary"/>
        </FrameLayout>

        <!-- Filename & Metadata Row -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/textName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="document.pdf"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Enterprise Metadata Row -->
            <LinearLayout
                android:id="@+id/layoutMetaRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <!-- Size Badge -->
                <TextView
                    android:id="@+id/textDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2.4 MB"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:background="@drawable/bg_meta_chip"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"/>

                <!-- Date / Timestamp Chip -->
                <TextView
                    android:id="@+id/chipDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oct 8, 2026"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:background="@drawable/bg_meta_chip"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="6dp"/>

                <!-- Role / Access Badge (e.g., Read Only or Owned) -->
                <TextView
                    android:id="@+id/chipRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Read-Only"
                    android:textColor="@color/badge_viewer_fg"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_badge_viewer"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginStart="6dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Kebab Overflow Menu -->
        <ImageButton
            android:id="@+id/btnAction"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_secondary"
            android:contentDescription="Options"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
