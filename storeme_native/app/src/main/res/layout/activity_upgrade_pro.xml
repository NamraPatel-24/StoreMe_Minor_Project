<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_void">

    <!-- Close Button -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_close"
        app:tint="@color/text_secondary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_gravity="top|end"
        android:contentDescription="Close"/>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="56dp"
            android:paddingBottom="40dp">

            <!-- Hero Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/primary"
                    android:background="@drawable/bg_file_icon_container"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="StoreMe Enterprise"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enterprise Storage Node &amp; Access Control Tier"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginBottom="14dp"/>

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/textPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIER: ENTERPRISE ACTIVE"
                    android:textColor="@color/badge_admin_fg"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:background="@drawable/bg_badge_admin"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"/>
            </LinearLayout>

            <!-- Features Card (High contrast dark surface with subtle border) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StoreMeNative.Card.Enterprise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="@dimen/card_radius"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/bg_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active Organization Policies"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="16dp"/>

                    <!-- Feature rows -->
                    <include layout="@layout/item_pro_feature"
                        android:id="@+id/feat1"/>
                    <include layout="@layout/item_pro_feature"
                        android:id="@+id/feat2"/>
                    <include layout="@layout/item_pro_feature"
                        android:id="@+id/feat3"/>
                    <include layout="@layout/item_pro_feature"
                        android:id="@+id/feat4"/>
                    <include layout="@layout/item_pro_feature"
                        android:id="@+id/feat5"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Comparison Table Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.StoreMeNative.Card.Enterprise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="@dimen/card_radius"
                app:strokeColor="@color/border_subtle"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/bg_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="2"
                            android:layout_height="wrap_content"
                            android:text="Capability"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Basic"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Enterprise"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:gravity="center"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_subtle"
                        android:layout_marginBottom="12dp"/>

                    <!-- Rows -->
                    <include layout="@layout/item_compare_row" android:id="@+id/cmp1"/>
                    <include layout="@layout/item_compare_row" android:id="@+id/cmp2"/>
                    <include layout="@layout/item_compare_row" android:id="@+id/cmp3"/>
                    <include layout="@layout/item_compare_row" android:id="@+id/cmp4"/>
                    <include layout="@layout/item_compare_row" android:id="@+id/cmp5"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Primary Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuyPro"
                style="@style/Widget.StoreMeNative.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Enterprise Node Verified"
                android:textAllCaps="false"
                android:layout_marginBottom="10dp"/>

            <!-- Secondary Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestore"
                style="@style/Widget.StoreMeNative.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Synchronize Security Policies"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"/>

            <!-- Security Footnote -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Zero-Knowledge Encryption • RBAC Enabled • Private P2P"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:layout_marginTop="16dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
